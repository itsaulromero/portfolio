{
  "name": "portfolio",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "nuxt build",
    "commitlint": "commitlint --edit",
    "dev": "nuxt dev",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "generate": "nuxt generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint-staged": "lint-staged",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "preview": "nuxt preview",
    "stylelint": "stylelint \"**/*.{css,vue}\" --allow-empty-input",
    "stylelint:fix": "stylelint \"**/*.{css,vue}\" --fix --allow-empty-input",
    "typecheck": "nuxt typecheck",
    "validate": "pnpm lint && pnpm format:check && pnpm stylelint && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@fontsource-variable/roboto": "5.3.0",
    "nuxt": "4.5.2",
    "simple-icons": "^16.31.0",
    "vue": "3.5.42",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@nuxt/eslint": "1.17.0",
    "@nuxtjs/color-mode": "4.0.1",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/tailwindcss": "6.14.0",
    "eslint": "10.10.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "postcss-html": "2.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "stylelint": "17.15.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-vue": "2.0.0",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.11"
  }
}
